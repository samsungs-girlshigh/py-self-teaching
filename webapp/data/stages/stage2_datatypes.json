      { "term": "불형(bool)", "desc": "True 또는 False" },
      { "term": "문자열(str)", "desc": "따옴표로 감싼 문자, 예: \"용사\"" },
      { "term": "type()", "desc": "괄호 안 값의 자료형을 알려주는 함수" }
